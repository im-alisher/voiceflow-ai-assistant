# =============================================================================
# Voiceflow — root environment contract (EXAMPLE ONLY)
# =============================================================================
# This file is a *template*. Copy it to `.env` and fill in real values locally.
#   cp .env.example .env
# `.env` is git-ignored. Never commit real credentials.
#
# Ownership of variables:
#   APP_* / SHARED_*  -> consumed by both API and Web
#   API_*             -> consumed by @voiceflow/api only
#   VITE_*            -> consumed by @voiceflow/web only (must be VITE_ prefixed)
# =============================================================================

# --- Shared application identity --------------------------------------------
APP_NAME="Voiceflow"
APP_ENV=development
APP_VERSION=0.1.0
APP_SUPPORT_EMAIL="support@voiceflow.local"

# --- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
API_BODY_LIMIT=1mb

# --- Database (PostgreSQL) ----------------------------------------------------
# NOTE: migrations are intentionally NOT auto-generated or auto-run.
# The operator provisions the schema manually.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=voiceflow
DB_SCHEMA=public
DB_SSL=false
DB_POOL_SIZE=10
DB_LOGGING=false
# Explicitly disabled — schema changes are handled by hand-written migrations.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# --- Auth ---------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TTL=7d
JWT_ISSUER=voiceflow
JWT_AUDIENCE=voiceflow-web
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# --- AI provider abstraction --------------------------------------------------
# `mock` is the default and requires no credentials whatsoever.
AI_PROVIDER=mock
AI_DEFAULT_MODEL=mock-assistant-v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONTEXT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.7

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Web ----------------------------------------------------------------------
VITE_APP_NAME="Voiceflow"
VITE_API_BASE_URL=http://localhost:4000/api
VITE_API_TIMEOUT_MS=30000
VITE_ENABLE_MOCK_AI=true
VITE_ENABLE_DEVTOOLS=true
