# =============================================================================
# Voiceflow web client — environment template (EXAMPLE ONLY)
# =============================================================================
# Copy to `apps/web/.env` and adjust. Only variables prefixed with `VITE_` are
# exposed to the browser bundle; everything else stays on the server.
#
# Never put a secret in this file. `VITE_*` values are inlined into the built
# JavaScript and are therefore public.
# =============================================================================

VITE_APP_NAME="Voiceflow"
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=30000

# Proxy target used by `vite dev` only; ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:4000

# Client-side feature switches (see packages/shared/src/config/feature-flags.ts
# for the canonical list).
VITE_ENABLE_MOCK_AI=true
VITE_ENABLE_DEVTOOLS=true
