# =============================================================================
# Voiceflow API — environment template (EXAMPLE ONLY)
# =============================================================================
# Copy to `apps/api/.env` and fill in real values, or export the variables in
# your shell / container orchestrator. The service validates every variable at
# boot and refuses to start when something required is missing.
#
# NOTE: schema migrations are NEVER generated or executed automatically.
# `DB_SYNCHRONIZE` and `DB_MIGRATIONS_RUN` are hard-disabled in code.
# =============================================================================

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:5173
API_BODY_LIMIT=1mb
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_DATABASE=voiceflow
DB_SCHEMA=public
DB_SSL=false
DB_POOL_SIZE=10
DB_LOGGING=false
DB_RETRY_ATTEMPTS=10

# openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
# openssl rand -base64 48
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_TTL=7d
JWT_ISSUER=voiceflow
JWT_AUDIENCE=voiceflow-web
BCRYPT_SALT_ROUNDS=12
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

AI_PROVIDER=mock
AI_DEFAULT_MODEL=mock-assistant-v1
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_CONTEXT_TOKENS=8000
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.7

LOG_LEVEL=debug
LOG_PRETTY=true
